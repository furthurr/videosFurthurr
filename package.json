{
  "name": "furthurr-videos",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/generate-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src scripts tests e2e '*.ts' '*.json' index.html .github/workflows/pages.yml README.md supabase/functions/manage-video/index.ts",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  }
}
